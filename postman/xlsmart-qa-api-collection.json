{
  "info": {
    "_postman_id": "ebbb8852-0321-4392-a442-aec1d1544281",
    "name": "XLSmart QA Assessment - API Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "5741589",
    "_collection_link": "https://go.postman.co/collection/5741589-ebbb8852-0321-4392-a442-aec1d1544281?source=collection_link"
  },
  "item": [
    {
      "name": "POST /va - Valid Request (TC-01)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// ===========================================\r",
              "// XLSmart VA API - Reusable Pre-request Script\r",
              "// ===========================================\r",
              "\r",
              "// Credentials\r",
              "const merchant_index = \"MCP2023011830\";\r",
              "const secret_unbound_id = \"0x00558c744cb597f6b0\";\r",
              "const hash_key = \"fsNmnFkUGG8nhKYpQGzDWQ4bMQZKA6QGBBRgrbx+tMI\";\r",
              "\r",
              "// ===========================================\r",
              "// 1. Generate Authorization Header\r",
              "// ===========================================\r",
              "const authString = merchant_index + \":\" + secret_unbound_id;\r",
              "const encodedAuth = CryptoJS.enc.Base64.stringify(\r",
              "    CryptoJS.enc.Utf8.parse(authString)\r",
              ");\r",
              "const authorization = \"Basic \" + encodedAuth;\r",
              "\r",
              "// ===========================================\r",
              "// 2. Generate Dynamic IDs\r",
              "// ===========================================\r",
              "const timestamp = Date.now();\r",
              "\r",
              "const external_id =\r",
              "    \"AUTO_TEST_EXT-\" + timestamp;\r",
              "\r",
              "const order_id =\r",
              "    \"AUTO_TEST_ORDER-\" + timestamp;\r",
              "\r",
              "// ===========================================\r",
              "// 3. Generate Signature\r",
              "// ===========================================\r",
              "const signaturePayload =\r",
              "    hash_key + external_id + order_id;\r",
              "\r",
              "const xReqSignature =\r",
              "    CryptoJS.SHA256(signaturePayload).toString();\r",
              "\r",
              "// ===========================================\r",
              "// 4. Set Required Headers\r",
              "// ===========================================\r",
              "pm.request.headers.upsert({\r",
              "    key: \"Authorization\",\r",
              "    value: authorization\r",
              "});\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"x-req-signature\",\r",
              "    value: xReqSignature\r",
              "});\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"x-version\",\r",
              "    value: \"v3\"\r",
              "});\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"Content-Type\",\r",
              "    value: \"application/json\"\r",
              "});\r",
              "\r",
              "// ===========================================\r",
              "// 5. Base Valid Request Body\r",
              "// ===========================================\r",
              "let requestBody = {\r",
              "    external_id: external_id,\r",
              "    order_id: order_id,\r",
              "    currency: \"IDR\",\r",
              "    payment_method: \"bank_transfer\",\r",
              "    payment_channel: \"MANDIRI\",\r",
              "    payment_details: {},\r",
              "    billing_name: \"Auto Test Customer\",\r",
              "    payment_system: \"CLOSED\",\r",
              "    amount: 100000,\r",
              "    transaction_description:\r",
              "        \"Auto test transaction\",\r",
              "    customer_details: {\r",
              "        email: \"autotest@example.com\",\r",
              "        full_name: \"Auto Test User\",\r",
              "        phone: \"81234567890\"\r",
              "    },\r",
              "    callback_url:\r",
              "        \"https://merchant-test.example.com/callback\"\r",
              "};\r",
              "\r",
              "// ===========================================\r",
              "// 6. Override Section For Negative Test Cases\r",
              "// ===========================================\r",
              "\r",
              "// TC-13 → Amount below minimum\r",
              "// requestBody.amount = 5000;\r",
              "\r",
              "// TC-14 → Invalid email format\r",
              "// requestBody.customer_details.email = \"invalidemail\";\r",
              "\r",
              "// TC-15 → Phone number too short\r",
              "// requestBody.customer_details.phone = \"123\";\r",
              "\r",
              "// TC-16 → Phone number too long\r",
              "// requestBody.customer_details.phone = \"1234567890123456\";\r",
              "\r",
              "// TC-17 → Invalid currency\r",
              "// requestBody.currency = \"USD\";\r",
              "\r",
              "// TC-18 → Invalid payment_channel\r",
              "// requestBody.payment_channel = \"BCA\";\r",
              "\r",
              "// TC-19 → Invalid callback URL\r",
              "// requestBody.callback_url = \"not-a-url\";\r",
              "\r",
              "// TC-20 → Invalid payment_system\r",
              "// requestBody.payment_system = \"INVALID\";\r",
              "\r",
              "// TC-22 → external_id exceeds max length\r",
              "// requestBody.external_id = \"X\".repeat(65);\r",
              "\r",
              "// TC-23 → order_id exceeds max length\r",
              "// requestBody.order_id = \"Y\".repeat(66);\r",
              "\r",
              "// TC-24 → SQL injection payload\r",
              "// requestBody.billing_name = \"' OR '1'='1\";\r",
              "\r",
              "// TC-25 → XSS payload\r",
              "// requestBody.billing_name = \"<script>alert(1)</script>\";\r",
              "\r",
              "// TC-26 → Remove optional payment_system\r",
              "// delete requestBody.payment_system;\r",
              "\r",
              "// TC-27 → Remove optional expired_time\r",
              "// delete requestBody.expired_time;\r",
              "\r",
              "// TC-28 → expired_time in the past\r",
              "// requestBody.expired_time = \"2024-01-01T00:00:00.000+07:00\";\r",
              "\r",
              "// TC-29 → Invalid expired_time format\r",
              "// requestBody.expired_time = \"2025-12-31\";\r",
              "\r",
              "// ===========================================\r",
              "// 7. Set Request Body\r",
              "// ===========================================\r",
              "pm.request.body.raw =\r",
              "    JSON.stringify(requestBody, null, 2);\r",
              "\r",
              "// ===========================================\r",
              "// 8. Store Variables For Cleanup\r",
              "// ===========================================\r",
              "pm.collectionVariables.set(\r",
              "    \"created_external_id\",\r",
              "    external_id\r",
              ");\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"created_order_id\",\r",
              "    order_id\r",
              ");\r",
              "\r",
              "// ===========================================\r",
              "// 9. Debug Logs\r",
              "// ===========================================\r",
              "console.log(\"Authorization:\", authorization);\r",
              "console.log(\"x-req-signature:\", xReqSignature);\r",
              "console.log(\"Request Body:\", requestBody);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
